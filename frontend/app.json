{
  "expo": {
    "name": "Splitty",
    "slug": "Splitty",
    "owner": "santitanus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splittyLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "splitty",
    "splash": {
      "image": "./assets/splittyLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4F1"
    },
    "android": {
      "icon": "./assets/splittyLogo.png",
      "package": "com.splitty.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "splitty",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "splash": {
        "backgroundColor": "#E6F4F1",
        "resizeMode": "contain",
        "image": "./assets/splittyLogo.png"
      }
    },
    "web": {
      "favicon": "./assets/splittyLogo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a la cámara para escanear códigos QR"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "proguardMinify": true,
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "BACKEND_URL": "https://splitty-azieva.fly.dev/",
      "eas": {
        "projectId": "d4288f8f-e584-4de7-87eb-facedcec213e"
      }
    }
  }
}
